{
  "name": "@jurfi/ui",
  "version": "0.0.0",
  "description": "CSS-only design tokens and themes",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./themes.css": "./dist/tokens/themes.css",
    "./*": "./dist/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "lint": "stylelint \"src/**/*.css\" --config ../../stylelint.config.js"
  },
  "devDependencies": {
    "@jurfi/postcss-config": "workspace:*",
    "@jurfi/stylelint-config": "workspace:*",
    "postcss": "^8.5.30",
    "stylelint": "^17.16.0"
  }
}
