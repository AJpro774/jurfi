{
  "name": "@jurfi/script",
  "version": "0.0.0",
  "description": "Visual scripting compiler and runtime",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@jurfi/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "eslint": "^9.39.0",
    "@jurfi/tsconfig": "workspace:*",
    "@jurfi/vitest-config": "workspace:*",
    "@jurfi/eslint-config": "workspace:*"
  }
}
