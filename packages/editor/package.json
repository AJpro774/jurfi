{
  "name": "@jurfi/editor",
  "version": "0.0.0",
  "description": "Jurfi editor",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/shell.css",
    "src/panels.css",
    "src/timeline/timeline.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell.css": "./src/shell.css",
    "./panels.css": "./src/panels.css",
    "./timeline.css": "./src/timeline/timeline.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@jurfi/anim": "workspace:*",
    "@jurfi/core": "workspace:*",
    "@jurfi/physics": "workspace:*",
    "@jurfi/render": "workspace:*",
    "@jurfi/script": "workspace:*",
    "@jurfi/ui": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "happy-dom": "^20.0.10",
    "eslint": "^9.39.0",
    "@types/three": "^0.186.0",
    "@jurfi/tsconfig": "workspace:*",
    "@jurfi/vitest-config": "workspace:*",
    "@jurfi/eslint-config": "workspace:*"
  }
}
