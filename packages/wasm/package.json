{
  "name": "@jurfi/wasm",
  "version": "0.0.0",
  "description": "Jurfi wasm",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "pkg"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pkg": {
      "types": "./pkg/jurfi_wasm.d.ts",
      "import": "./pkg/jurfi_wasm.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:wasm": "wasm-pack build --target bundler --release --out-dir pkg",
    "test:rust": "cargo test"
  },
  "dependencies": {
    "@jurfi/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "eslint": "^9.39.0",
    "@jurfi/tsconfig": "workspace:*",
    "@jurfi/vitest-config": "workspace:*",
    "@jurfi/eslint-config": "workspace:*"
  }
}
